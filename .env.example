# mcp-mailcow — example .env (copy to .env next to main.py and edit).
# Every value below is a FAKE placeholder. .env is git-ignored; never commit it.
#
# Precedence: CLI flag > real environment variable > .env > built-in default.
# A variable that already exists in the environment (even as an empty string)
# is NOT overwritten by .env.
# Syntax: KEY=VALUE, full-line "# comments", optional '...' or "..." quotes,
# inline "# comment" after a space on unquoted values.
# In unquoted values everything after a space + # is a comment, so wrap any value
# that contains a # character in quotes.

# --- Server ------------------------------------------------------------------
# Required (or pass --mode): user = IMAP/SMTP mailbox, admin = Mailcow REST API,
# all = admin tools + user tools for the mailboxes in MCP_MAILCOW_MAILBOXES.
MCP_MAILCOW_MODE=admin
# stdio (default) or http.
MCP_MAILCOW_TRANSPORT=http
# HTTP bind address. Default 0.0.0.0.
MCP_MAILCOW_HOST=0.0.0.0
# HTTP port. If unset: SERVER_PORT (Pterodactyl), else 8000.
MCP_MAILCOW_PORT=8000

# --- HTTP security -------------------------------------------------------------
# Bearer token clients must send (Authorization: Bearer <token>). Required for
# --transport http. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_MAILCOW_AUTH_TOKEN=replace-with-a-long-random-token
# Only "true" allows starting HTTP without a token (logs a warning). Keep false.
MCP_MAILCOW_ALLOW_NO_AUTH=false
# Write tools (create/update/delete/send). Default: true for stdio, false for http.
# all mode: false for every transport (and the 3 send tools use ENABLE_MAIL_SEND instead).
MCP_MAILCOW_ENABLE_WRITE_TOOLS=false
# Optional Host-header allow-list (comma-separated, host:* = any port). Empty = no check.
MCP_MAILCOW_ALLOWED_HOSTS=
# Optional browser Origin allow-list, used only when MCP_MAILCOW_ALLOWED_HOSTS is set.
MCP_MAILCOW_ALLOWED_ORIGINS=

# --- admin mode ----------------------------------------------------------------
MAILCOW_ADMIN_URL=https://mail.example.com
MAILCOW_ADMIN_API_KEY=FAKE-API-KEY-0000-0000-000000000000
# Request timeout in seconds. Default 60.
MCP_MAILCOW_API_TIMEOUT=60

# --- user mode (only when MCP_MAILCOW_MODE=user) --------------------------------
# MAILCOW_HOST=mail.example.com
# MAILCOW_MAIL_USER=you@example.com
# MAILCOW_MAIL_PASS=fake-app-password
# MAILCOW_IMAP_HOST=mail.example.com
# MAILCOW_SMTP_HOST=mail.example.com
# MAILCOW_IMAP_PORT=993
# MAILCOW_SMTP_PORT=587

# --- all mode (only when MCP_MAILCOW_MODE=all) ----------------------------------
# Uses the admin-mode variables above plus the ones below. MAILCOW_MAIL_USER/PASS
# are not used: the server creates a short-lived IMAP+SMTP app password
# ("mcp-temp-...") per mailbox through the admin API and deletes it afterwards.
# Required. Comma-separated, case-insensitive; "*" allows every mailbox (avoid).
# MCP_MAILCOW_MAILBOXES=support@example.com, sales@example.com
# IMAP/SMTP host. Default: the host of MAILCOW_ADMIN_URL. MAILCOW_IMAP_*/SMTP_*
# from the user-mode section apply as well.
# MAILCOW_HOST=mail.example.com
# send_message / reply_to_message / forward_message. Default false.
# MCP_MAILCOW_ENABLE_MAIL_SEND=false
# true un-hides the 14 account-takeover-class admin tools (mailbox_set_password,
# app_password_*, domain_admin_*, ...). Mail bodies are untrusted input (prompt
# injection), so keep this false.
# MCP_MAILCOW_ALLOW_SENSITIVE_TOOLS=false
# Seconds a temporary app password is reused before it is deleted (30-86400). Default 600.
# MCP_MAILCOW_TEMP_PASSWORD_TTL=600

# --- common ----------------------------------------------------------------------
# Audit log (JSONL). Default: ~/.local/state/mcp-mailcow/audit.log
# MCP_MAILCOW_AUDIT_LOG=/home/container/audit.log
# false disables TLS verification (self-signed certs only). Default true.
MCP_MAILCOW_TLS_VERIFY=true
